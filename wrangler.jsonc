{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ------------------------------------------------------------------
  // DELIVERY OS — Cloudflare Workers（静的アセットのみ）
  //
  // サイト本体はリポジトリのルートをそのまま配信する（ファイルは移動しない）。
  // 配信したくないファイルは .assetsignore に書く。
  // GitHub Pages も並行して動くので、どちらからでも同じサイトが開く。
  //
  // データベースは使わないので、APIトークンに要るのは Workers の編集権限だけ。
  //
  //   npx wrangler dev      ローカルで確認（http://localhost:8787）
  //   npx wrangler deploy   公開
  // ------------------------------------------------------------------
  "name": "delivery-os",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-24",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // 実在しないパスは 404.html を返す（SPAではないので single-page-application にしない）
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }

  // 独自ドメインを取ったら、ここを外して自分のドメインに書き換える。
  // （Cloudflare Registrar で取得＝そのままゾーンが入るので、これだけで繋がる）
  //
  // "routes": [
  //   { "pattern": "example.com", "custom_domain": true },
  //   { "pattern": "www.example.com", "custom_domain": true }
  // ]
}
